# Copiar este archivo a .env y ajustar usuario, clave y base. NUNCA versionar .env.

# Dirección de la base (obligatoria). Debe usar el driver asincrónico postgresql+asyncpg.
DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/libreria

# Muestra en consola las sentencias SQL (true/1/yes/on activan; cualquier otro valor desactiva).
SQL_ECHO=false
