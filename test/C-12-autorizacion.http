@base = http://127.0.0.1:8000

# C-12: autorización por roles y grupos de rutas (abierto / protegido).
# Requisitos previos, en este orden:
#   1. alembic upgrade head            (cabeza 0004)
#   2. python scripts/seed.py
#   3. psql -f test/C-12-preparacion.sql   (admin@, admin2@, vendedor@, nuevo@ example.com; provisorio hasta C-14)
#   4. uvicorn app.main:app
# Contrasenas de mentira (ver C-12-preparacion.sql):
#   admin@ clave-admin-1 | admin2@ clave-admin-2 | vendedor@ clave-vendedor-1 | nuevo@ clave-nuevo-1
# Cada pedido va con `# @no-cookie-jar` y la cookie se pasa a mano: varias sesiones a la vez.
# Los correos de registro llevan {{$timestamp}} para no depender de corridas anteriores.
# Para repetir una corrida completa: restablecer la base (alembic downgrade base, upgrade head, `python scripts/seed.py`; el alta de tomas@ lo deja con usuario) y despues el .sql
# (nuevo@ cambia su contrasena en la seccion C-09; las revocaciones de la seccion final quitan roles a vendedor@ y admin2@).

# ===================== SESIONES =====================

### C-12 login: administrador
# Esperado: HTTP/1.1 200 OK. Set-Cookie: access_token=...; HttpOnly; Path=/; SameSite=lax
# @name loginAdmin
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "admin@example.com", "password": "clave-admin-1" }

### C-12 login: segundo administrador
# Esperado: HTTP/1.1 200 OK.
# @name loginAdmin2
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "admin2@example.com", "password": "clave-admin-2" }

### C-12 login: vendedor
# Esperado: HTTP/1.1 200 OK.
# @name loginVendedor
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "vendedor@example.com", "password": "clave-vendedor-1" }

### C-12 login: vendedor con cambio de contrasena pendiente
# Esperado: HTTP/1.1 200 OK (el login funciona aunque deba cambiar la contrasena).
# @name loginNuevo
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "nuevo@example.com", "password": "clave-nuevo-1" }

### C-12 registro de un cliente (rol CLIENTE)
# Esperado: HTTP/1.1 201 Created.
# @name registroCliente
# @no-cookie-jar
POST {{base}}/auth/registro
Content-Type: application/json

{ "email": "cli{{$timestamp}}@example.com", "nombre": "Cliente de C-12", "password": "clave-segura-1" }

### C-12 login: cliente
# Esperado: HTTP/1.1 200 OK.
# @name loginCliente
# @no-cookie-jar
POST {{base}}/auth/login
Content-Type: application/json

{ "email": "{{registroCliente.response.body.$.email}}", "password": "clave-segura-1" }

# ===================== 401 vs 403 (caso C-06, parte de autorización) =====================

### C-12 401: crear editorial sin cookie
# Esperado: HTTP/1.1 401 Unauthorized. {"detail": "No hay una sesión válida"}  (no 201 ni 403)
# @no-cookie-jar
POST {{base}}/editoriales/
Content-Type: application/json

{ "nombre": "Sin Cookie {{$timestamp}}", "pais": "Argentina" }

### C-12 401: crear editorial con token alterado
# Esperado: HTTP/1.1 401 Unauthorized. {"detail": "No hay una sesión válida"}
# Cookie: el token de loginAdmin con el ultimo caracter de la firma cambiado (a mano o con el runner).
# @no-cookie-jar
POST {{base}}/editoriales/
Content-Type: application/json
Cookie: access_token=<token de loginAdmin con el ultimo caracter cambiado>

{ "nombre": "Token Alterado {{$timestamp}}", "pais": "Argentina" }

### C-12 403: crear libro como vendedor
# Esperado: HTTP/1.1 403 Forbidden. {"detail": "No tenés permiso para esta operación"}
# psql: SELECT count(*) FROM libro WHERE isbn = '978-950-00-1201-0';  -> 0 (no se creó ningún libro)
# @no-cookie-jar
POST {{base}}/libros/
Content-Type: application/json
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

{ "isbn": "978-950-00-1201-0", "titulo": "Libro del Vendedor", "precio": "100.00", "stock": 1, "editorial_id": 1 }

### C-12 403: crear venta como cliente
# Esperado: HTTP/1.1 403 Forbidden. {"detail": "No tenés permiso para esta operación"}
# @no-cookie-jar
POST {{base}}/ventas/
Content-Type: application/json
Cookie: {{loginCliente.response.headers.Set-Cookie}}

{ "cliente_id": 1, "renglones": [ { "libro_id": 1, "cantidad": 1 } ] }

### C-12 201: crear editorial como administrador
# Esperado: HTTP/1.1 201 Created.
# @no-cookie-jar
POST {{base}}/editoriales/
Content-Type: application/json
Cookie: {{loginAdmin.response.headers.Set-Cookie}}

{ "nombre": "Editorial C-12 {{$timestamp}}", "pais": "Argentina" }

### C-12 401: GET /clientes/abc sin cookie (la sesion se resuelve antes que la validacion)
# Esperado: HTTP/1.1 401 Unauthorized. {"detail": "No hay una sesión válida"}  (no 422)
# @no-cookie-jar
GET {{base}}/clientes/abc

### C-12 422: GET /clientes/abc como vendedor
# Esperado: HTTP/1.1 422 Unprocessable Entity (autorizado: recién ahí valida el parámetro).
# @no-cookie-jar
GET {{base}}/clientes/abc
Cookie: {{loginVendedor.response.headers.Set-Cookie}}

# ===================== CAMBIO OBLIGATORIO DE CONTRASENA (caso C-09) =====================
# nuevo@example.com tiene debe_cambiar_password = true. Solo puede usar /auth/*, /health/* y rutas abiertas.

### C-12 cambio pendiente: POST /ventas/ bloqueado
# Esperado: HTTP/1.1 403 Forbidden. {"detail": "Tenés que cambiar la contraseña antes de seguir"}
# @no-cookie-jar
POST {{base}}/ventas/
Content-Type: application/json
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

{ "cliente_id": 1, "renglones": [ { "libro_id": 1, "cantidad": 1 } ] }

### C-12 cambio pendiente: GET /auth/yo sigue funcionando
# Esperado: HTTP/1.1 200 OK con "debe_cambiar_password": true y "roles_vigentes": ["VENDEDOR"].
# @no-cookie-jar
GET {{base}}/auth/yo
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

### C-12 cambio pendiente: GET /libros/ (ruta abierta) sigue funcionando
# Esperado: HTTP/1.1 200 OK.
# @no-cookie-jar
GET {{base}}/libros/
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

### C-12 cambio pendiente: POST /auth/cambiar-password
# Esperado: HTTP/1.1 200 OK.
# psql: SELECT debe_cambiar_password FROM usuario WHERE email = 'nuevo@example.com';  -> f
# @no-cookie-jar
POST {{base}}/auth/cambiar-password
Content-Type: application/json
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

{ "password_actual": "clave-nuevo-1", "password_nueva": "clave-nuevo-2" }

### C-12 cambio hecho: el mismo POST /ventas/ con la MISMA cookie
# Esperado: HTTP/1.1 201 Created (el control lee la base en cada petición; la cookie no cambia).
# @no-cookie-jar
POST {{base}}/ventas/
Content-Type: application/json
Cookie: {{loginNuevo.response.headers.Set-Cookie}}

{ "cliente_id": 1, "renglones": [ { "libro_id": 1, "cantidad": 1 } ] }

