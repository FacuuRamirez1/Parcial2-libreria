@base = http://127.0.0.1:8000

### POST crear cliente (201)
# Esperado: HTTP/1.1 201 Created
# Cuerpo: {"id": 1, "nombre": "Juan Perez", "email": "juan@example.com", "usuario_id": null}
POST {{base}}/clientes
Content-Type: application/json

{
  "nombre": "Juan Perez",
  "email": "juan@example.com"
}

### GET lista clientes (200 paginado)
# Esperado: HTTP/1.1 200 OK
# Cuerpo: {"items": [...], "total": 1, "page": 1, "size": 20, "pages": 1}
GET {{base}}/clientes?page=1&size=20

### GET cliente por id existente (200)
# Esperado: HTTP/1.1 200 OK
# Cuerpo: {"id": 1, "nombre": "Juan Perez", "email": "juan@example.com", "usuario_id": null}
GET {{base}}/clientes/1

### GET cliente por id inexistente (404)
# Esperado: HTTP/1.1 404 Not Found
# Cuerpo: {"detail": "Cliente no encontrado"}
GET {{base}}/clientes/999999

### PATCH cliente (200)
# Esperado: HTTP/1.1 200 OK
# Cuerpo: {"id": 1, "nombre": "Juan Perez Gonzalez", "email": "juan@example.com", "usuario_id": null}
PATCH {{base}}/clientes/1
Content-Type: application/json

{
  "nombre": "Juan Perez Gonzalez"
}

### POST crear perfil de cliente (201)
# Esperado: HTTP/1.1 201 Created
# Cuerpo: {"id": 1, "telefono": "555-0100", "direccion": "Calle Falsa 123", "cliente_id": 1}
# Nota: cliente_id en el cuerpo es opcional; el id de la ruta es autoritativo.
POST {{base}}/clientes/1/perfil
Content-Type: application/json

{
  "telefono": "555-0100",
  "direccion": "Calle Falsa 123"
}

### POST email duplicado (409)
# Esperado: HTTP/1.1 409 Conflict
# Cuerpo: {"detail": "El email del cliente ya esta registrado"}
POST {{base}}/clientes
Content-Type: application/json

{
  "nombre": "Otro cliente",
  "email": "juan@example.com"
}

### POST segundo perfil al mismo cliente (409)
# Esperado: HTTP/1.1 409 Conflict
# Cuerpo: {"detail": "El cliente ya tiene un perfil asociado"}
POST {{base}}/clientes/1/perfil
Content-Type: application/json

{
  "telefono": "555-0101",
  "direccion": "Otra direccion"
}

### POST perfil de cliente inexistente (409, mensaje propio)
# Esperado: HTTP/1.1 409 Conflict
# Cuerpo: {"detail": "Cliente no encontrado"}
POST {{base}}/clientes/999999/perfil
Content-Type: application/json

{
  "telefono": "555-0100",
  "direccion": "Calle Falsa 123"
}

### POST perfil con cliente_id inconsistente (422)
# Esperado: HTTP/1.1 422 Unprocessable Entity
# Cuerpo: {"detail": "El cliente_id del cuerpo no coincide con el de la ruta"}
POST {{base}}/clientes/1/perfil
Content-Type: application/json

{
  "telefono": "555-0100",
  "direccion": "Calle Falsa 123",
  "cliente_id": 2
}

### POST perfil con telefono de 31 caracteres (422)
# Esperado: HTTP/1.1 422 Unprocessable Entity
# Cuerpo: {"detail": [{"type": "string_too_long", "loc": ["body", "telefono"], ...}]}
POST {{base}}/clientes/1/perfil
Content-Type: application/json

{
  "telefono": "1111111111111111111111111111111",
  "direccion": "Calle Falsa 123"
}
