# Copiar este archivo a .env y ajustar usuario, clave y base. NUNCA versionar .env.
# Los valores de abajo son ejemplos; JWT_SECRET_KEY y POSTGRES_PASSWORD no tienen
# valor por defecto en el código: si faltan, la aplicación no arranca.

# Credenciales de la base de datos (obligatorias).
POSTGRES_USER=usuario
POSTGRES_PASSWORD=cambiar-esta-clave-en-produccion
POSTGRES_DB=libreria
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Clave de firma del JWT (obligatoria, sin valor por defecto).
JWT_SECRET_KEY=cambiar-esta-clave-en-produccion

# Costo de bcrypt (por defecto 12).
BCRYPT_COST=12

# Tamaño del pool de conexiones del motor asincrónico (por defecto 5).
DB_POOL_SIZE=5

# Máximo de cálculos bcrypt simultáneos (semáforo); el resto espera turno (por defecto 4).
BCRYPT_CONCURRENCIA=4

# Algoritmo de firma del JWT (por defecto HS256).
JWT_ALGORITMO=HS256

# Secure de la cookie de sesión (true/false).
COOKIE_SECURE=false

# Duración del token de acceso en minutos (por defecto 30).
ACCESS_TOKEN_MINUTES=30

# Muestra en consola las sentencias SQL (true/1/yes/on activan; otro valor desactiva).
SQL_ECHO=false
